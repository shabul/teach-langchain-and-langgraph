# ── Local model (default — no key needed) ────────────────────────────────────
#
# Start LM Studio, load a model, and enable the REST API server.
# The app will use this automatically when LM Studio is running.
#
# LM_STUDIO_URL=http://localhost:1234   # uncomment to change the default port


# ── Cloud fallback (used when LM Studio is NOT running) ──────────────────────
#
# Add ONE key below. The app detects which one is present and uses it.
#
# Option A — OpenAI  (models: gpt-4o-mini)
# OPENAI_API_KEY=sk-...
#
# Option B — Anthropic  (models: claude-haiku-4-5)
# ANTHROPIC_API_KEY=sk-ant-...
